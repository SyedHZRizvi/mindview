# MindView _redirects — Cloudflare Pages URL routing
# Rules evaluated top-to-bottom; first match wins.
# Updated 2026-06-03.
#
# IMPORTANT: Cloudflare Pages already serves every .html file at its
# clean URL automatically (courses/mcr3u.html is accessible as both
# /courses/mcr3u.html AND /courses/mcr3u without any rules here).
# Do NOT add /courses/:code → /courses/:code.html rules — they cause
# a redirect loop because CF Pages internally strips .html before
# checking _redirects, then the rule sends it back to .html → loop.

# ── Auth routes ──────────────────────────────────────────────────────
/login                  /admin/login.html               200
/admin                  /admin/dashboard.html           200

# ── Top-level multi-page routes (CF Pages handles .html → clean URL
#    automatically; these rules map the clean URL to the real file) ──
/catalog                /catalog.html                   200
/enrolment              /enrolment.html                 200
/resources              /resources.html                 200
/video-policy           /video-policy.html              200

# ── Typo heal: /course/:code (missing 's') → /courses/:code.html ─────
# This only matches URLs WITHOUT .html (e.g. someone types /course/eng4u)
/course/:code           /courses/:code.html             301

# ── Security: block dev/config files from being served ───────────────
/app.py                 /404.html                       404
/users.db               /404.html                       404
/.secret_key            /404.html                       404
/wrangler.toml          /404.html                       404
/package.json           /404.html                       404
/.env                   /404.html                       404
/.env.local             /404.html                       404
