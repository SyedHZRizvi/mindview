# MindView _redirects — Cloudflare Pages URL routing
# Rules evaluated top-to-bottom; first match wins.
# Updated 2026-06-03.

# ── Auth routes ──────────────────────────────────────────────────────
/login                  /admin/login.html               200
/admin                  /admin/dashboard.html           200

# ── Top-level page routes (strip .html for clean URLs) ───────────────
/catalog                /catalog.html                   200
/enrolment              /enrolment.html                 200
/resources              /resources.html                 200
/video-policy           /video-policy.html              200

